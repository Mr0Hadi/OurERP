{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.js",
    "tools/dev-inspector/client.js"
  ],
  "project": [
    "src/**/*.{js,jsx}",
    "scripts/**/*.js",
    "tools/**/*.js"
  ],
  "ignore": [
    "src/shared/components/ui/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@fontsource-variable/vazirmatn",
    "shadcn",
    "tailwind-scrollbar-hide",
    "tailwindcss",
    "tw-animate-css"
  ]
}
