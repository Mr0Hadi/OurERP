  // Path to the LibreOffice headless executable used to convert the filled official invoice
  // template to PDF (ExcelInvoiceDocumentService). Not in PATH by default on Windows - override
  // with the actual soffice.exe location, e.g. "C:\\Program Files\\LibreOffice\\program\\soffice.exe".
  // On Linux deploy targets "soffice" resolving via PATH is usually enough.
  "LibreOffice": {
    "ExecutablePath": "soffice",
    "ConversionTimeoutSeconds": 60
  },
  // Which engine renders invoices / credit notes:
  //   "LibreOffice" (default) - fills the official Excel template and converts it with the
  //                             soffice binary configured above. Highest fidelity to the official
  //                             form, but requires LibreOffice installed on the host.
  //   "QuestPdf"              - QuestPdfInvoiceDocumentService, laid out in-process with QuestPDF.
  //                             No external process, so it works anywhere the API runs; visually
  //                             close to the official form rather than identical to it.
  // Nothing else changes when this is flipped - the endpoints resolve IPdfDocumentService from DI.
  "InvoiceRenderer": {
    "Engine": "QuestPdf"
  }
}
