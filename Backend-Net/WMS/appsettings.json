{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=93.126.6.132\\MSSQLSERVER2019;Database=pasargad_;User Id=pasargad;Password=dp4TmY5QO~71u&;TrustServerCertificate=true"
  },
  // Must be full ORIGINS - scheme + host + port. A bare host like "localhost" can never match
  // anything, which is what CORS was silently failing on: WithOrigins() matched no request, no
  // Access-Control-Allow-Origin header was ever emitted, and every browser call from the Vite dev
  // server was blocked. Add the deployed frontend's origin here before going to production.
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "JwtSettings": {
    "SigningKey": "21f3b6f24878208d6fd748a26db9da4a",
    "EncryptionKey": "8e60f14b0875e5793b974b7590d448a7",
    "Issuer": "pasargadmp.ir",
    "Audience": "pasargadmp.ir",
    "TokenDurationInMinutes": 1,
    "RefreshTokenDurationInMinutes": 3
  },
  // Password guessing: after MaxFailedAttempts wrong passwords in a row an account is locked for
  // LockoutMinutes (a manager's password reset also unlocks it). RateLimitPerMinutePerIp caps login
  // attempts per client IP - kept generous because a whole office usually shares one public IP.
  "LoginSecurity": {
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 5,
    "RateLimitPerMinutePerIp": 60
  },
  // Secret for the keyed hash that replaces national ids, economic codes and phone numbers in the
  // request log (WMS/Logging/LogRedactor.cs). Set it per environment with the
  // LogRedaction__HashKey environment variable - a long random string, never committed. While it is
  // blank those fields are removed from the log instead of hashed. Changing it means old log
  // entries can no longer be searched with new hashes.
  "LogRedaction": {
    "HashKey": ""
  },
  // Largest request body accepted, in bytes (10 MB). Image uploads are capped separately by
  // ObjectStorage:MaxImageSizeBytes.
  "RequestLimits": {
    "MaxBodyBytes": 10485760
  },
  "Encryption": {
    "symmetricKey": "030c70bca9fce94ade1e8895fd02ae84"
  },
  // Liara Object Storage (S3-compatible). Fill AccessKey/SecretKey/BucketName from the Liara
  // panel before uploading anything - the placeholders below will fail with a 503.
  // Do NOT commit real keys: override them per environment with the
  // ObjectStorage__AccessKey / ObjectStorage__SecretKey environment variables.
  "ObjectStorage": {
    "Endpoint": "https://storage.c2.liara.site",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "wms",
    // This API's own public base URL. Image URLs point here (api/File/GetImage), NOT at the
    // bucket: Liara's storage edge answers "404 page not found" to any browser User-Agent, so a
    // storage URL can never load in an <img>. Change this per environment (deployed API host).
    "PublicBaseUrl": "http://localhost:5083",
    "PresignedUrlExpiryMinutes": 60,
    "MaxImageSizeBytes": 5242880,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif", ".pdf" ],
    "AllowedImageContentTypes": [ "image/jpeg", "image/png", "image/webp", "image/gif", "application/pdf" ]
  },
  "Company": {
    "Name": "شرکت پاسارگاد موتور پارس",
    "NationalId": "",
    "EconomicCode": "",
    "RegistrationNumber": "",
    "Address": "کرمان",
    "PhoneNumber": "",
    "PostalCode": "",
    "Province": "کرمان",
    "City": "کرمان",
    "Currency": "ریال"
  },
  // Path to the LibreOffice headless executable used to convert the filled official invoice
  // template to PDF (ExcelInvoiceDocumentService). Not in PATH by default on Windows - override
  // with the actual soffice.exe location, e.g. "C:\\Program Files\\LibreOffice\\program\\soffice.exe".
  // On Linux deploy targets "soffice" resolving via PATH is usually enough.
  "LibreOffice": {
    "ExecutablePath": "soffice",
    "ConversionTimeoutSeconds": 60
  },
  // Which engine renders invoices / credit notes:
  //   "LibreOffice" (default) - fills the official Excel template and converts it with the
  //                             soffice binary configured above. Highest fidelity to the official
  //                             form, but requires LibreOffice installed on the host.
  //   "QuestPdf"              - QuestPdfInvoiceDocumentService, laid out in-process with QuestPDF.
  //                             No external process, so it works anywhere the API runs; visually
  //                             close to the official form rather than identical to it.
  // Nothing else changes when this is flipped - the endpoints resolve IPdfDocumentService from DI.
  "InvoiceRenderer": {
    "Engine": "QuestPdf"
  }
}
