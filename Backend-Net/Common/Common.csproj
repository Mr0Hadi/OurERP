<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed by Paggination.ToPagedAsync: CountAsync/ToListAsync live in EF Core's
         EntityFrameworkQueryableExtensions. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by PeriodBucketing.cs, which buckets report periods on ReportPeriodTypeEnum.
         Domain has no dependencies of its own, so this creates no cycle. -->
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

</Project>
